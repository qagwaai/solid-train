{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "solar-system-get-request",
  "type": "object",
  "required": ["playerName", "sessionKey", "correlationId", "requestIdentity", "solarSystemId"],
  "properties": {
    "playerName": { "type": "string" },
    "sessionKey": { "type": "string" },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Client-generated UUID v4 used to correlate each request/response pair."
    },
    "requestIdentity": {
      "type": "object",
      "required": ["operation", "entityType", "containerId"],
      "properties": {
        "operation": { "type": "string" },
        "entityType": { "type": "string" },
        "containerId": { "type": "string" }
      }
    },
    "solarSystemId": { "type": "string" },
    "navigation": { "$ref": "./navigation-state-request.schema.json" },
    "navigationEstimate": { "$ref": "./navigation-estimate-options.schema.json" },
    "asOf": { "type": "string", "format": "date-time", "description": "Existing ordinary lazy-seed timestamp. Ignored when navigation is supplied: the read-only projection uses only the verified ship position epoch and never seeds." },
    "requestId": { "type": "string" }
  },
  "dependencies": { "navigationEstimate": ["navigation"] }
}
