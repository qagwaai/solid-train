{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "solar-system-get-response",
  "type": "object",
  "definitions": {
    "vector3": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "required": ["x", "y", "z"]
    },
    "primaryStarSummary": {
      "type": ["object", "null"],
      "properties": {
        "hygId": { "type": "string" },
        "spectralClass": {
          "type": ["string", "null"],
          "description": "Optional source spectral class; omitted and null both mean unknown. Current normalized reads serialize unknown as null; no generation fallback is used."
        },
        "spectralType": { "type": ["string", "null"] },
        "colorHex": { "type": "string" },
        "colorIndexBv": { "type": ["number", "null"] },
        "luminositySolar": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Optional source luminosity in solar luminosities; omitted and null both mean unknown. Zero is valid and is not equivalent to unknown."
        },
        "massSolar": { "type": "number" },
        "radiusSolar": { "type": "number" },
        "absoluteMagnitude": { "type": ["number", "null"] },
        "properName": { "type": ["string", "null"] }
      },
      "required": [
        "hygId",
        "spectralClass",
        "spectralType",
        "colorHex",
        "colorIndexBv",
        "luminositySolar",
        "massSolar",
        "radiusSolar",
        "absoluteMagnitude",
        "properName"
      ]
    },
    "solarSystemSummary": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "hygSystemId": { "type": "string" },
        "source": { "type": "string", "enum": ["curated", "procedural"] },
        "isMultiStar": { "type": "boolean" },
        "positionPc": {
          "$ref": "#/definitions/vector3",
          "description": "HYG-fixture system-wide coordinate in parsecs; it is not spatial.positionKm and is not converted or added to the system-local celestial snapshots."
        },
        "distanceParsec": { "type": ["number", "null"] },
        "primaryStar": { "$ref": "#/definitions/primaryStarSummary" },
        "starCount": { "type": "integer" },
        "generationSeed": { "type": ["integer", "null"] },
        "planetCount": { "type": "integer" },
        "moonCount": { "type": "integer" },
        "asteroidCount": { "type": "integer" },
        "marketCount": { "type": "integer" }
      },
      "required": [
        "id",
        "displayName",
        "hygSystemId",
        "source",
        "isMultiStar",
        "positionPc",
        "distanceParsec",
        "primaryStar",
        "starCount",
        "generationSeed"
      ]
    },
    "spatialState": {
      "$ref": "./spatial-state.schema.json"
    },
    "motionState": {
      "type": ["object", "null"],
      "properties": {
        "velocityKmPerSec": { "$ref": "#/definitions/vector3" },
        "angularVelocityRadPerSec": {
          "anyOf": [{ "$ref": "#/definitions/vector3" }, { "type": "null" }]
        }
      },
      "required": ["velocityKmPerSec"]
    },
    "physicalState": {
      "$ref": "./celestial-physical-estimates.schema.json"
    },
    "observabilityState": {
      "type": "object",
      "properties": {
        "visibility": { "type": "string", "enum": ["visible", "not-visible", "cloaked"] },
        "scanState": { "type": "string", "enum": ["unscanned", "scanned"] }
      },
      "required": ["visibility", "scanState"]
    },
    "compositionState": {
      "type": ["object", "null"],
      "properties": {
        "rarity": { "type": "string", "enum": ["Common", "Uncommon", "Rare", "Exotic"] },
        "material": { "type": "string", "pattern": "\\S" },
        "textureColor": { "type": "string", "pattern": "\\S" }
      },
      "required": ["rarity", "material", "textureColor"]
    },
    "physicalCatalog": {
      "$ref": "./celestial-physical-catalog.schema.json"
    },
    "visualization": {
      "type": ["object", "null"],
      "properties": {
        "colorHex": { "type": ["string", "null"] },
        "spectralClass": { "type": ["string", "null"] },
        "textureKey": { "type": ["string", "null"] }
      }
    },
    "debrisEntry": {
      "type": "object",
      "properties": {
        "material": { "type": "string" },
        "rarity": { "type": "string" },
        "quantity": { "type": "integer" },
        "itemType": { "$ref": "./canonical-item-type.schema.json" },
        "externalObjectDescriptor": {
          "$ref": "./external-object-descriptor.schema.json"
        }
      },
      "required": ["material", "rarity", "quantity", "itemType"]
    },
    "celestialBody": {
      "type": "object",
      "allOf": [{ "$ref": "./celestial-classification.schema.json" }],
      "description": "Canonical celestial body payload with optional catalog enrichments.",
      "properties": {
        "catalogIdentity": { "$ref": "./catalog-identity.schema.json" },
        "id": {
          "type": "string",
          "description": "Durable canonical identity and deterministic appearance-generator input."
        },
        "surfaceArchetype": {
          "type": "string",
          "enum": [
            "rocky",
            "lava",
            "ocean",
            "gas-giant",
            "ice-giant",
            "star",
            "rocky-moon",
            "icy-moon",
            "asteroid"
          ]
        },
        "catalogId": { "type": "string" },
        "sourceScanId": { "type": "string" },
        "createdByCharacterId": { "type": "string" },
        "missionId": { "type": ["string", "null"] },
        "missionInstanceId": { "type": ["string", "null"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "spatial": { "$ref": "#/definitions/spatialState" },
        "motion": { "$ref": "#/definitions/motionState" },
        "physical": { "$ref": "#/definitions/physicalState" },
        "observability": { "$ref": "#/definitions/observabilityState" },
        "composition": { "$ref": "#/definitions/compositionState" },
        "externalObjectDescriptor": {
          "$ref": "./external-object-descriptor.schema.json"
        },
        "state": { "type": "string", "enum": ["unscanned", "active", "destroyed"] },
        "destroyedAt": { "type": ["string", "null"] },
        "destroyedReason": { "type": ["string", "null"] },
        "debrisSeed": { "type": ["integer", "null"] },
        "debris": {
          "type": "array",
          "items": { "$ref": "#/definitions/debrisEntry" }
        },
        "bodyType": {
          "type": "string",
          "enum": ["star", "planet", "dwarf-planet", "moon", "asteroid", "tno", "comet"]
        },
        "spectralClass": {
          "type": ["string", "null"],
          "description": "Optional per-body source spectral class, including companions; omitted and null both mean unknown. Current normalized reads serialize unknown as null."
        },
        "luminositySolar": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Optional per-body source luminosity in solar luminosities; omitted and null both mean unknown. Current normalized reads serialize unknown as null. Zero is valid."
        },
        "displayName": { "type": ["string", "null"] },
        "parentBodyId": { "type": ["string", "null"] },
        "orbitalElements": { "$ref": "./orbital-elements.schema.json" },
        "physicalCatalog": { "$ref": "#/definitions/physicalCatalog" },
        "atmosphere": { "type": ["object", "null"], "additionalProperties": true },
        "discovery": { "type": ["object", "null"], "additionalProperties": true },
        "magnitudes": { "type": ["object", "null"], "additionalProperties": true },
        "planetType": { "type": ["string", "null"] },
        "hygId": { "type": ["string", "null"] },
        "visualization": { "$ref": "#/definitions/visualization" },
        "clusterId": { "type": "string" },
        "clusterCenterKm": { "$ref": "#/definitions/vector3" },
        "localOffsetKm": { "$ref": "#/definitions/vector3" },
        "distanceFromClusterCenterKm": { "type": "number" },
        "isCatalogBody": { "type": "boolean" }
      },
      "required": [
        "id",
        "surfaceArchetype",
        "bodyType",
        "catalogId",
        "sourceScanId",
        "createdByCharacterId",
        "missionId",
        "missionInstanceId",
        "createdAt",
        "updatedAt",
        "spatial",
        "observability",
        "state",
        "destroyedAt",
        "destroyedReason",
        "debrisSeed",
        "debris"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "success",
    "message",
    "playerName",
    "solarSystemId",
    "correlationId",
    "requestIdentity"
  ],
  "properties": {
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Echo of the request correlationId."
    },
    "requestIdentity": {
      "type": "object",
      "required": ["operation", "entityType", "containerId"],
      "properties": {
        "operation": { "type": "string" },
        "entityType": { "type": "string" },
        "containerId": { "type": "string" }
      }
    },
    "playerName": { "type": "string" },
    "solarSystemId": { "type": "string" },
    "solarSystem": {
      "$ref": "#/definitions/solarSystemSummary",
      "description": "Present on successful solar system lookup responses."
    },
    "bodies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/celestialBody"
      }
    },
    "stars": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/celestialBody"
      }
    },
    "requestId": {
      "type": "string",
      "description": "Echoed caller correlation id when one was supplied on the request."
    }
  }
}
