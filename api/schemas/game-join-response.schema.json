{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "game-join-response",
  "type": "object",
  "required": [
    "success",
    "message",
    "playerName",
    "characterId",
    "correlationId",
    "requestIdentity"
  ],
  "properties": {
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "correlationId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "Exact echo of the request UUID v4."
    },
    "requestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "entityType", "containerId"],
      "properties": {
        "operation": { "const": "game-join" },
        "entityType": { "const": "game-session" },
        "containerId": { "type": "string", "pattern": "\\S" }
      }
    },
    "reason": {
      "enum": ["invalid_request", "invalid_session", "character_not_found", "outcome_unknown"]
    },
    "playerName": { "type": "string" },
    "characterId": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "success": { "const": true } } },
      "then": {
        "properties": {
          "correlationId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "requestIdentity": { "type": "object" }
        },
        "not": { "required": ["reason"] }
      },
      "else": { "required": ["reason"] }
    }
  ]
}
