{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "game-join-request",
  "type": "object",
  "required": ["playerName", "sessionKey", "correlationId", "requestIdentity", "characterId"],
  "properties": {
    "playerName": { "type": "string" },
    "sessionKey": { "type": "string" },
    "correlationId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "Client-generated UUID v4 used to correlate each request/response pair."
    },
    "requestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "entityType", "containerId"],
      "properties": {
        "operation": { "const": "game-join" },
        "entityType": { "const": "game-session" },
        "containerId": { "type": "string", "pattern": "\\S" }
      }
    },
    "characterId": { "type": "string" }
  }
}
