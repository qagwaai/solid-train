{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "character-list-response",
  "type": "object",
  "required": [
    "success",
    "message",
    "playerName",
    "characters",
    "correlationId",
    "requestIdentity"
  ],
  "properties": {
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Echo of the request correlationId."
    },
    "requestIdentity": {
      "type": "object",
      "required": ["operation", "entityType", "containerId"],
      "properties": {
        "operation": { "type": "string" },
        "entityType": { "type": "string" },
        "containerId": { "type": "string" }
      }
    },
    "playerName": { "type": "string" },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Character summary snapshot. credits and creditLedger are always included. Use credit-ledger-list for filtered/paged ledgers and the authoritative full balance.",
        "required": ["id", "characterName", "credits", "creditLedger"],
        "properties": {
          "id": { "type": "string" },
          "characterName": { "type": "string" },
          "level": { "type": "number" },
          "createdAt": { "type": "string", "format": "date-time" },
          "credits": {
            "type": "number",
            "description": "Snapshot derived from the entire creditLedger: sum(put.amount) - sum(take.amount); zero for an empty ledger."
          },
          "creditLedger": {
            "type": "array",
            "description": "Complete unfiltered ledger in append order, included even when empty. Entry IDs match credit-ledger-list.",
            "items": { "$ref": "./credit-ledger-entry.schema.json" }
          },
          "ships": { "type": "array" },
          "inGame": { "type": "boolean" },
          "gameJoinedAt": { "type": "string", "format": "date-time" },
          "gameLastMessageReceivedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": true
      }
    }
  }
}
